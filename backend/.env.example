# Copy this file to `.env` (same folder) and pick ONE option below.
# Without any of this, Crescent still works fully using built-in rules.

# --- Option A: cloud AI (provider auto-detected from the key prefix) -------
#   gsk_...  = Groq (free tier)   sk-... = OpenAI   xai-... = xAI   sk-or-... = OpenRouter
LLM_API_KEY=your-key-here
# LLM_MODEL=llama-3.3-70b-versatile

# --- Option B: local AI with Ollama (free, private, runs on your computer) --
#   1. install Ollama from https://ollama.com
#   2. run:  ollama pull llama3.1
#   3. uncomment these two lines (and leave LLM_API_KEY as is):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1
#
#   LM Studio / llama.cpp / vLLM instead:
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=your-model-name

# --- Optional -------------------------------------------------------------
# LLM_CHAT_MODE=rules          # force the rule-based assistant even with a model set
# LLM_TIMEOUT=90               # seconds (local models can be slow)
# DATABASE_PATH=data/crescent.db
# SESSION_DAYS=30              # how long a login lasts
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
